{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "incremental": false,
    "isolatedModules": false
  },
  "include": ["api/**/*.ts", "server/**/*.ts", "game/**/*.ts", "types/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next"]
}
